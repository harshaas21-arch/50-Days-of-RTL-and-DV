module uart_tx #( 
    parameter CLK_FREQ = 1_000_000, 
    parameter BAUD_RATE = 100_000 
)( 
    input clk, rst, tx_start, 
    input [7:0] tx_data, 
    output tx, 
    output tx_busy 
); 
    localparam BAUD_DIV = CLK_FREQ / BAUD_RATE; 

    reg [$clog2(BAUD_DIV):0] baud_cnt; 
    reg [3:0] bit_cnt;  
    reg [9:0] piso_reg; 

    // tx_busy is active from the moment we start until the 10th bit (Stop Bit) is done
    assign tx_busy = (bit_cnt != 0); 
    
    // While busy, send the LSB. While idle, keep the line High (1).
    assign tx = (tx_busy) ? piso_reg[0] : 1'b1; 

    always @(posedge clk) begin 
        if (rst) begin 
            baud_cnt <= 0; 
            bit_cnt  <= 0; 
            piso_reg <= 10'h3FF; 
        end else begin
            if (!tx_busy) begin 
                if (tx_start) begin 
                    // Load: {Stop Bit (1), Data (8 bits), Start Bit (0)}
                    piso_reg <= {1'b1, tx_data, 1'b0}; 
                    bit_cnt  <= 1; 
                    baud_cnt <= 0; 
                end 
            end else begin 
                if (baud_cnt == BAUD_DIV - 1) begin 
                    baud_cnt <= 0; 
                    if (bit_cnt == 10) begin
                        bit_cnt <= 0; // Transmission complete
                    end else begin
                        piso_reg <= {1'b1, piso_reg[9:1]}; // Shift out LSB, shift in 1
                        bit_cnt  <= bit_cnt + 1; 
                    end
                end else begin 
                    baud_cnt <= baud_cnt + 1; 
                end 
            end 
        end
    end 
endmodule

`timescale 1ns / 1ps

module tb_uart_tx();
    // 1. Parameters - 1MHz clock, 100k Baud
    parameter CLK_FREQ = 1_000_000;
    parameter BAUD_RATE = 100_000;
    
    // Each bit lasts 10,000ns (10 clock cycles)
    localparam BIT_PERIOD = 10000; 

    reg clk, rst, tx_start;
    reg [7:0] tx_data;
    wire tx, tx_busy;

    // 2. Instantiate Unit Under Test
    uart_tx #(CLK_FREQ, BAUD_RATE) uut (
        .clk(clk), .rst(rst),
        .tx_start(tx_start), .tx_data(tx_data),
        .tx(tx), .tx_busy(tx_busy)
    );

    // 3. 1MHz Clock generation (1000ns period)
    always #500 clk = ~clk;

    // VCD Dump
    initial begin
        $dumpfile("uart_tx1.vcd");
        $dumpvars(0, tb_uart_tx);
    end

    // 4. Test Stimulus
    initial begin
        // Initialize
        clk = 0; rst = 1; tx_start = 0; tx_data = 0;
        
        // Wait 5 clock cycles for reset (5 * 1000ns)
        #5000 rst = 0; 
        #2000; // Small buffer

        // --- TEST: Send Character 'A' (8'h41 -> 01000001) ---
        @(negedge clk);
        tx_data = 8'h41;
        tx_start = 1;
        @(negedge clk);
        tx_start = 0;

        $display("--- Transmission Started at %0t ---", $time);
        
        // Move to the middle of the Start Bit
        // We wait for the first posedge (where the TX starts) + half bit period
        #(BIT_PERIOD/2); 
        $display("Start Bit: %b (Expected: 0)", tx);
        
        // Loop through 8 Data Bits (LSB first: 1, 0, 0, 0, 0, 0, 1, 0)
        repeat (8) begin
            #(BIT_PERIOD);
            $display("Data Bit at %0t: %b", $time, tx);
        end
        
        // Wait for Stop Bit
        #(BIT_PERIOD);
        $display("Stop Bit at %0t: %b (Expected: 1)", $time, tx);

        // Wait until tx_busy drops
        wait(!tx_busy);
        $display("--- Transmission Finished at %0t ---", $time);

        #5000 $finish;
    end
endmodule


